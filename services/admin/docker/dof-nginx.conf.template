worker_processes 1;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;
    keepalive_timeout 65;
    server {
        listen ${NGINX_PORT};
        server_name localhost;
        location / {
            root /app/static;
            index index.html;
            try_files $uri $uri/ /index.html;
        }
        # Exact status routes must reach Spring without Nginx's automatic
        # slash redirect (which loses an SSH-forwarded external port).
        location = /api/v1/admin/dof/client {
            proxy_pass http://127.0.0.1:${SERVER_PORT};
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
        location = /api/v1/admin/dof/script {
            proxy_pass http://127.0.0.1:${SERVER_PORT};
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
        # 2 MiB images use up to 2.67 MiB as JSON base64. This limit is only
        # in the isolated Dof image and does not change the production proxy.
        location /api/v1/admin/dof/client/ {
            client_max_body_size 3m;
            proxy_read_timeout 1800s;
            proxy_buffering off;
            proxy_pass http://127.0.0.1:${SERVER_PORT};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
        # PVF bytes stream straight into the authenticated, bounded upload store.
        # Do not let Nginx create a second large request/response temporary copy.
        location = /api/v1/admin/dof/script/uploads {
            client_max_body_size 2048m;
            client_body_timeout 300s;
            proxy_http_version 1.1;
            proxy_request_buffering off;
            proxy_buffering off;
            proxy_send_timeout 1800s;
            proxy_read_timeout 1800s;
            proxy_pass http://127.0.0.1:${SERVER_PORT};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
        location /api/v1/admin/dof/script/ {
            client_max_body_size 32k;
            proxy_buffering off;
            proxy_read_timeout 1800s;
            proxy_pass http://127.0.0.1:${SERVER_PORT};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
        # Streaming equipment-rule files: fixed modules and read-only endpoints only.
        location ~ ^/api/v1/admin/activities/(inheritance|recovery|cross-border)/dataset/(export|check)$ {
            client_max_body_size 256m;
            client_body_timeout 1800s;
            proxy_http_version 1.1;
            proxy_request_buffering off;
            proxy_buffering off;
            proxy_read_timeout 1800s;
            proxy_send_timeout 1800s;
            proxy_pass http://127.0.0.1:${SERVER_PORT};
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
        location ~ ^/api/v1/admin/activities/(inheritance|recovery|cross-border)/batches/import/preview$ {
            client_max_body_size 256m;
            client_body_timeout 1800s;
            proxy_http_version 1.1;
            proxy_request_buffering off;
            proxy_buffering off;
            proxy_read_timeout 1800s;
            proxy_send_timeout 1800s;
            proxy_pass http://127.0.0.1:${SERVER_PORT};
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
        location /api/v1 {
            proxy_pass http://127.0.0.1:${SERVER_PORT};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
