# Local credentials, runtime state and build products
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
**/runtime/
!/services/game/runtime/
**/node_modules/
**/target/
**/__pycache__/
*.py[cod]
*.log
*.tar
*.tar.gz
*.zip
*.7z
*.pem
*.key
*.pfx
*.p12
**/.idea/
**/.vs/
/clients/launcher/bin/
/clients/launcher/obj/
/services/admin/data/
/dist/
/artifacts/
/work/
*.code-workspace

# Public upstream template keys required by the game image (not production secrets)
!/services/game/assets/home/template/init/publickey.pem
!/services/game/assets/home/template/neople/game/HSPub.key

.download-*
*.tmp
.DS_Store
Thumbs.db

# Per-user IDE state
*.user
*.suo

# Operator-supplied optional QK binaries, copied into the image locally.
/services/game/assets/root/QK
/services/game/assets/root/qk_plugin.so
/services/game/assets/root/qingkong/
/services/game/assets/root/dungeon.lst
/services/game/assets/home/template/neople/game/libantisvrinline.so

# Deployment-local credentials and player distributions
**/bootstrap-admin.sql
**/admin-initial-credentials.txt
**/packages/

# Checked-in compatibility source archives are build inputs, not output packages.
!/services/game/docker/ubuntu/*.tar.gz

